from kivy.app import App
from kivy.uix.label import Label
from kivy.uix.button import Button
from kivy.uix.boxlayout import BoxLayout

class MojaApp(App):
    def build(self) -> BoxLayout:
        koren = BoxLayout(orientation="vertical")

        self.vysledok = Label(text="text")
        tlacidlo = Button(text="Klikni ma")
        tlacidlo.bind(on_press=self.klik)
        mojetlačidlo2 = Button(text="Klikni ma 2")
        mojetlačidlo2.bind(on_press=self.klik2)
        koren.add_widget(self.vysledok)
        koren.add_widget(tlacidlo)
        koren.add_widget(mojetlačidlo2)
        return koren

    def klik(self, instancia):
        self.vysledok.text = "Klikol si!"        
        label = Label(text="Klikol si!")
    def klik2(self, instancia):
        self.vysledok.text = "Klikol si 2!"

MojaApp().run()